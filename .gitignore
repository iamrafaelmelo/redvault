# --- Dados locais (nunca versionar) ---------------------------------------
# data/ contém o banco SQLite, o secret.key que deriva as flags e o estado dos
# labs. Nada disso pertence ao repositório público.
/data/

# SQLite WAL sidecar files are runtime state, not part of the database file.
*.db-shm
*.db-wal

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/

# --- Testes e ferramentas ------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editores / sistema --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs / temporários --------------------------------------------------
*.log
/tmp/

# --- Imagens importadas do HackTricks -------------------------------------
# ~112 MB de imagens copiadas do clone upstream (CC BY-NC). Não versionar:
# o importador (scripts/import_kb.py --source hacktricks) as recria a partir
# do clone local. Mantê-las fora do Git evita inflar o repositório e
# redistribuir mídia de terceiros.
app/static/hacktricks/
