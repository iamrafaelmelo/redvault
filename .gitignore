# --- Dados locais (versionados de propósito: instalação de um único operador) --
# data/ contém o banco SQLite, o secret.key e o estado dos labs.
# ATENÇÃO: data/secret.key deriva TODAS as flags. Este repo é privado e de uso
# pessoal. Se ele virar público ou ganhar colaboradores, remova data/ do Git.
data/labs/state/
data/labs/logs/
# SQLite WAL sidecar files are runtime state, not part of the tracked DB.
*.db-shm
*.db-wal

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/

# --- Testes e ferramentas ------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editores / sistema --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs / temporários --------------------------------------------------
*.log
/tmp/

# --- Imagens importadas do HackTricks -------------------------------------
# ~112 MB de imagens copiadas do clone upstream (CC BY-NC). Não versionar:
# o importador (scripts/import_kb.py --source hacktricks) as recria a partir
# do clone local. Mantê-las fora do Git evita inflar o repositório e
# redistribuir mídia de terceiros.
app/static/hacktricks/
